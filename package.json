{
  "name": "drp-dynamic-recharge-platform",
  "productName": "DRP - Dynamic Recharge Platform",
  "version": "0.1.0",
  "description": "Charger monitoring, billing and invoice printing console for OCPP 1.6 CSMS",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"vite --config renderer/vite.config.js\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build --config renderer/vite.config.js",
    "dist": "npm run build:renderer && electron-builder",
    "postinstall": "electron-rebuild -o better-sqlite3"
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.drp.dynamic-recharge-platform",
    "win": {
      "icon": "assets/logo/logo.ico"
    },
    "files": [
      "main/**/*",
      "renderer/dist/**/*",
      "assets/logo/**/*"
    ],
    "directories": {
      "output": "build"
    }
  }
}
